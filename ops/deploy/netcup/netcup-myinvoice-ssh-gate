#!/bin/sh
set -eu
set -f

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

SUDO=/usr/bin/sudo
case ${NETCUP_MYINVOICE_GATE_TEST_MODE-} in
  '') ;;
  1)
    [ "${0##*/}" = netcup-myinvoice-ssh-gate.test ] || {
      printf 'Gate test mode requires the dedicated .test copy\n' >&2
      exit 2
    }
    [ "$(/usr/bin/id -u)" -ne 0 ] || {
      printf 'Gate test mode is forbidden for root\n' >&2
      exit 2
    }
    SUDO=${NETCUP_MYINVOICE_GATE_TEST_SUDO:?test sudo path required}
    [ -x "$SUDO" ] || {
      printf 'Gate test sudo is not executable\n' >&2
      exit 2
    }
    ;;
  *)
    printf 'Invalid gate test mode\n' >&2
    exit 2
    ;;
esac

original=${SSH_ORIGINAL_COMMAND-}
[ -n "$original" ] || {
  printf 'A deployment command is required\n' >&2
  exit 2
}

single_line=$(printf '%s' "$original" | /usr/bin/tr -d '\r\n')
[ "$single_line" = "$original" ] || {
  printf 'Multiline deployment commands are forbidden\n' >&2
  exit 2
}

if printf '%s\n' "$original" | /usr/bin/grep -Eq \
  "^sudo /usr/local/sbin/netcup-myinvoice-deploy candidate 'ghcr\.io/kahanekdusan/myinvoice@sha256:[0-9a-f]{64}' '[0-9a-f]{40}'$"; then
  program=/usr/local/sbin/netcup-myinvoice-deploy
  mode=candidate
elif printf '%s\n' "$original" | /usr/bin/grep -Eq \
  "^sudo /usr/local/sbin/netcup-myinvoice-promote promote 'ghcr\.io/kahanekdusan/myinvoice@sha256:[0-9a-f]{64}' '[0-9a-f]{40}'$"; then
  program=/usr/local/sbin/netcup-myinvoice-promote
  mode=promote
else
  printf 'Only an exact MyInvoice candidate or promote command is allowed\n' >&2
  exit 2
fi

old_ifs=$IFS
IFS=' '
set -- $original
IFS=$old_ifs
[ "$#" -eq 5 ] || exit 2

image=${4#\'}
image=${image%\'}
revision=${5#\'}
revision=${revision%\'}

exec "$SUDO" -n "$program" "$mode" "$image" "$revision"
