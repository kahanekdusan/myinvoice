{% extends '_layout.html.twig' %}

{% block content %}
<h1 style="margin:0 0 16px;font-size:22px;font-weight:600;color:#15131D;">
  {% if is_test %}<span style="color:#E8A547;">[TEST] </span>{% endif %}{{ greeting }}
</h1>

<p style="margin:0 0 16px;">{{ intro_prefix }} <strong>{{ quote.quote_number ?: ('#' ~ quote.id) }}</strong>.</p>

{% if note_lines is defined and note_lines|length %}
  {% for line in note_lines %}
    <p style="margin:0 0 12px;color:#403B52;">{{ line }}</p>
  {% endfor %}
{% endif %}

<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;background:{{ accent_soft }};border-radius:8px;margin:16px 0;">
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;font-size:14px;color:#403B52;">
        <tr>
          <td style="padding:4px 0;color:#7A748C;width:42%;">Quote number</td>
          <td style="padding:4px 0;font-family:monospace;font-weight:600;color:#15131D;">{{ quote.quote_number ?: ('#' ~ quote.id) }}</td>
        </tr>
        <tr>
          <td style="padding:4px 0;color:#7A748C;">Issue date</td>
          <td style="padding:4px 0;">{{ quote.issue_date|date('M j, Y') }}</td>
        </tr>
        <tr>
          <td style="padding:4px 0;color:#7A748C;">Valid until</td>
          <td style="padding:4px 0;font-weight:600;">{{ quote.valid_until ? quote.valid_until|date('M j, Y') : '—' }}</td>
        </tr>
        <tr>
          <td style="padding:8px 0 0;color:#7A748C;border-top:1px solid #E5E0F4;">Quoted amount</td>
          <td style="padding:8px 0 0;border-top:1px solid #E5E0F4;font-size:18px;font-weight:700;color:{{ accent }};font-family:monospace;">
            {{ quote.total_with_vat|number_format(2, '.', ',') }} {{ quote.currency }}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="margin:16px 0 8px;font-size:14px;color:#5A5470;">
  The PDF quote is attached to this email.
</p>

{% if not is_test %}
<p style="margin:24px 0 0;font-size:13px;color:#7A748C;">
  Thank you for your cooperation.
</p>
{% endif %}

{% if is_test %}
<p style="margin:24px 0 0;padding:12px;background:#FDF6E9;border-left:2px solid #E8A547;font-size:13px;color:#8B6420;">
  <strong>This is a TEST email.</strong> It was not sent to the client.
</p>
{% endif %}
{% endblock %}
